+/// The rows of `Assets_manifest.txt` as `name,crc,wire_length`; `.z` names keep the
+/// compressed wire length and are marked not raw.
+fn manifest_rows(manifest: &[u8]) -> Vec<ManifestRow> {
+    let mut rows = Vec::new();
+    for line in String::from_utf8_lossy(manifest).lines() {
+        let mut fields = line.split(',');
+        let (Some(name), Some(crc), Some(wire), None) =
+            (fields.next(), fields.next(), fields.next(), fields.next())
+        else {
+            continue;
+        };
+        let (Ok(crc), Ok(wire)) = (crc.trim().parse::<u32>(), wire.trim().parse::<u64>()) else {
+            continue;
+        };
+        let name = name.trim().to_ascii_lowercase();
+        let raw = !name.ends_with(".z");
+        let name = name.strip_suffix(".z").unwrap_or(&name).to_owned();
+        rows.push(ManifestRow {
+            name,
+            crc,
+            wire,
+            raw,
+        });
+    }
+    rows
+}
+
+/// The client's own pack rows it can serve: manifest names whose row CRC (and, for a
+/// raw row, its wire length) equals an entry in one of the packs. Every pack is tried,
+/// so a name the first pack holds at another CRC still resolves from the right one.
+fn pack_entries(root: &Path, base: &[ManifestRow]) -> HashMap<String, PackEntry> {
+    let Ok(manifest_path) = regular(root, PACK_MANIFEST) else {
+        return HashMap::new();
+    };
+    let Ok(manifest) = bounded_read(&manifest_path, LIMIT) else {
+        return HashMap::new();
+    };
+    let Ok(folder) = regular_directory(root, PACK_FOLDER) else {
+        return HashMap::new();
+    };
+    let mut index: HashMap<String, Vec<PackEntry>> = HashMap::new();
+    let Ok(listing) = std::fs::read_dir(&folder) else {
+        return HashMap::new();
+    };
+    let mut packs: Vec<PathBuf> = listing
+        .flatten()
+        .map(|entry| entry.file_name())
+        .filter(|name| {
+            name.to_str()
+                .is_some_and(|name| name.starts_with(PACK_PREFIX) && name.ends_with(PACK_SUFFIX))
+        })
+        .map(|name| folder.join(name))
+        .collect();
+    packs.sort();
+    for pack in packs {
+        let Ok(name) = pack.strip_prefix(root).map(Path::to_str) else {
+            continue;
+        };
+        let Some(name) = name else { continue };
+        let Ok(pack) = regular(root, name) else {
+            continue;
+        };
+        if hard_link(&pack).unwrap_or(true) {
+            continue;
+        }
+        let Ok(entries) = read_pack_index(&pack) else {
+            continue;
+        };
+        for (name, (offset, size, crc)) in entries {
+            index.entry(name).or_default().push(PackEntry {
+                file: pack.clone(),
+                offset,
+                size,
+                crc,
+            });
+        }
+    }
+    let base_names: HashSet<&str> = base.iter().map(|row| row.name.as_str()).collect();
+    let mut entries = HashMap::new();
+    // A base row keeps its announced form; only a row this client can supply may fill
+    // it, and the pack never adds a second row for that name.
+    for row in base {
+        if row.raw && valid_path(&row.name) {
+            admit(&index, &mut entries, &row.name, row.crc, Some(row.wire));
+        }
+    }
+    for row in manifest_rows(&manifest) {
+        if base_names.contains(row.name.as_str()) || !valid_path(&row.name) {
+            continue;
+        }
+        admit(
+            &index,
+            &mut entries,
+            &row.name,
+            row.crc,
+            row.raw.then_some(row.wire),
+        );
+    }
+    entries
+}
+
+/// Admit the first entry whose size is in bounds and whose CRC (and, when given, size)
+/// matches the announced row.
+fn admit(
+    index: &HashMap<String, Vec<PackEntry>>,
+    entries: &mut HashMap<String, PackEntry>,
+    name: &str,
+    crc: u32,
+    wire: Option<u64>,
+) {
+    if entries.contains_key(name) {
+        return;
+    }
+    let Some(candidates) = index.get(name) else {
+        return;
+    };
+    for entry in candidates {
+        if entry.crc != crc || entry.size > ENTRY_LIMIT {
+            continue;
+        }
+        if wire.is_some_and(|wire| entry.size != wire) {
+            continue;
+        }
+        entries.insert(
+            name.to_owned(),
+            PackEntry {
+                file: entry.file.clone(),
+                offset: entry.offset,
+                size: entry.size,
+                crc,
+            },
+        );
+        return;
+    }
+}
+
+/// Append the client pack rows the base manifest lacks, in raw form (`name,crc,length`).
+fn merged_manifest(
+    manifest: &[u8],
+    pack: &HashMap<String, PackEntry>,
+    base: &[ManifestRow],
+) -> Vec<u8> {
+    let mut merged = manifest.to_vec();
+    let line: &[u8] = if manifest.windows(2).any(|window| window == b"\r\n") {
+        b"\r\n"
+    } else {
+        b"\n"
+    };
+    let known: HashSet<&str> = base.iter().map(|row| row.name.as_str()).collect();
+    let mut rows: Vec<(&String, &PackEntry)> = pack
+        .iter()
+        .filter(|(name, _)| !known.contains(name.as_str()))
+        .collect();
+    if rows.is_empty() {
+        return merged;
+    }
+    rows.sort_by(|left, right| left.0.cmp(right.0));
+    if !merged.ends_with(b"\n") && !merged.ends_with(b"\r") {
+        merged.extend_from_slice(line);
+    }
+    for (name, entry) in rows {
+        merged.extend_from_slice(format!("{name},{},{}", entry.crc, entry.size).as_bytes());
+        merged.extend_from_slice(line);
+    }
+    merged
+}
