+/// `assets/` resolved inside the client folder, refusing links and escapes.
+fn regular_directory(root: &Path, relative: &str) -> Result<PathBuf> {
+    let path = root.join(relative);
+    let metadata = std::fs::symlink_metadata(&path).map_err(io_error)?;
+    if !metadata.is_dir() || !path.canonicalize().map_err(io_error)?.starts_with(root) {
+        return Err(format!("Missing or unsafe client folder: {relative}"));
+    }
+    Ok(path)
+}
+
+/// The supplied packs' directory blocks: BE absolute next-block offset, BE entry count,
+/// then a length-prefixed name and BE (offset, size, crc32) (osfr-tools `catalog`).
+///
+/// Blocks must move strictly forward, so each block's entries have to fit before the
+/// next block; that bounds the total work by the pack size (17 bytes is the smallest
+/// entry: a 4-byte length, a 1-byte name and 12 bytes of fields).
+fn read_pack_index(path: &Path) -> io::Result<Vec<(String, (u64, u64, u32))>> {
+    const MAX_BLOCKS: usize = 65536;
+    const MIN_ENTRY: u64 = 17;
+    let size = std::fs::metadata(path)?.len();
+    let mut file = File::open(path)?;
+    let mut entries = Vec::new();
+    let mut visited = HashSet::new();
+    let mut block = 0_u64;
+    let be32 = |file: &mut File| -> io::Result<u32> {
+        let mut bytes = [0; 4];
+        file.read_exact(&mut bytes)?;
+        Ok(u32::from_be_bytes(bytes))
+    };
+    while !visited.contains(&block) {
+        if visited.len() >= MAX_BLOCKS || block.checked_add(8).is_none_or(|end| end > size) {
+            return Err(io::Error::new(io::ErrorKind::InvalidData, "bad pack block"));
+        }
+        visited.insert(block);
+        file.seek(SeekFrom::Start(block))?;
+        let next = u64::from(be32(&mut file)?);
+        let count = u64::from(be32(&mut file)?);
+        if next != 0 && (next <= block + 8 || next > size) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "bad pack block link",
+            ));
+        }
+        let end = if next == 0 { size } else { next };
+        if count > (end - block - 8) / MIN_ENTRY {
+            return Err(io::Error::new(io::ErrorKind::InvalidData, "bad pack count"));
+        }
+        for _ in 0..count {
+            let length = be32(&mut file)? as u64;
+            if !(1..=4096).contains(&length) {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "bad name length",
+                ));
+            }
+            let mut bytes = vec![0; length as usize];
+            file.read_exact(&mut bytes)?;
+            let name = String::from_utf8(bytes)
+                .map_err(|_| io::Error::new(io::ErrorKind::InvalidData, "bad pack name"))?;
+            if name.chars().any(char::is_control) {
+                return Err(io::Error::new(io::ErrorKind::InvalidData, "bad pack name"));
+            }
+            let offset = u64::from(be32(&mut file)?);
+            let entry = u64::from(be32(&mut file)?);
+            let crc = be32(&mut file)?;
+            if offset.checked_add(entry).is_none_or(|end| end > size) {
+                return Err(io::Error::new(io::ErrorKind::InvalidData, "bad pack entry"));
+            }
+            entries.push((name.to_ascii_lowercase(), (offset, entry, crc)));
+        }
+        if next == 0 {
+            return Ok(entries);
+        }
+        block = next;
+    }
+    Err(io::Error::new(
+        io::ErrorKind::InvalidData,
+        "bad pack blocks",
+    ))
+}
+
+/// One pack row's raw bytes, verified against the CRC the manifest announced.
+fn read_entry(entry: &PackEntry) -> io::Result<Vec<u8>> {
+    let mut file = File::open(&entry.file)?;
+    file.seek(SeekFrom::Start(entry.offset))?;
+    let mut raw = vec![0; entry.size as usize];
+    file.read_exact(&mut raw)?;
+    if crc32(&raw) != entry.crc {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "pack row CRC differs",
+        ));
+    }
+    Ok(raw)
+}
