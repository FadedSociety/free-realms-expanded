+    let card3 = b"\xff\xd8\xff\xe0 synthetic card three".as_slice();
+    let stale = b"\xff\xd8\xff\xe0 an older card".as_slice();
+    let base = b"synthetic base".as_slice();
+    fs::create_dir(scratch.0.join("indirect-assets")).unwrap();
+    fs::write(scratch.0.join("indirect-assets/flat.dds"), base).unwrap();
+    fs::write(
+        scratch.0.join("Assets_manifest.txt"),
+        format!("flat.dds,1,2\r\n{}", row("filled.dds", card2)),
+    )
+    .unwrap();
+    // The first pack holds `images/card/3.jpg` at an older CRC; the second holds the
+    // announced one.
+    fs::write(
+        assets.join("assetpack000W_000.pack"),
+        pack(&[
+            ("images/card/1.jpg", card),
+            ("images/card/2.jpg", card2),
+            ("images/card/3.jpg", stale),
+            ("flat.dds", card),
+        ]),
+    )
+    .unwrap();
+    fs::write(
+        assets.join("assetpack000W_001.pack"),
+        pack(&[("images/card/3.jpg", card3), ("filled.dds", card2)]),
+    )
+    .unwrap();
+    fs::write(
+        assets.join("assetpack000_manifest.txt"),
+        format!(
+            "{}{}{}{}images/card/missing.jpg,7,8\r\n",
+            row("images/card/1.jpg", card),
+            // A `.z` row is announced raw: the pack holds the raw bytes.
+            row("images/card/2.jpg.z", card2),
+            row("images/card/3.jpg", card3),
+            row("flat.dds", card),
+        ),
+    )
+    .unwrap();
+    let plan = LaunchPlan::build(
+        &scratch.0,
+        "127.0.0.1:20042",
+        None,
+        LaunchSettings::default(),
+        &mut LocalLoginStub,
+    )
+    .unwrap();
+    let url = plan.assets.url.clone();
+    let ok = "HTTP/1.0 200 OK".to_owned();
+    // Appended rows change the manifest CRC, so the client fetches the native envelope.
+    let (status, envelope) = get(&url, "/manifest.txt.z");
+    assert_eq!(status, ok);
+    assert_eq!(envelope[..4], 0xA1B2_C3D4_u32.to_be_bytes());
+    let served = inflate(&envelope[8..]);
+    assert_eq!(
+        u32::from_be_bytes(envelope[4..8].try_into().unwrap()) as usize,
+        served.len()
+    );
+    let text = String::from_utf8(served.clone()).unwrap();
+    assert!(text.starts_with("flat.dds,1,2\r\n"));
+    // Two base rows plus three appended pack rows, with no blank line between any.
+    assert_eq!(text.lines().count(), 5, "{text:?}");
+    assert!(!text.contains("\r\n\r\n"), "{text:?}");
+    assert!(text.contains(&format!(
+        "images/card/1.jpg,{},{}\r\n",
+        crc32(card),
+        card.len()
+    )));
+    assert!(text.contains(&format!(
+        "images/card/2.jpg,{},{}\r\n",
+        crc32(card2),
+        card2.len()
+    )));
+    assert!(text.contains(&format!(
+        "images/card/3.jpg,{},{}\r\n",
+        crc32(card3),
+        card3.len()
+    )));
+    assert!(text.contains(&format!("filled.dds,{},{}\r\n", crc32(card2), card2.len())));
+    assert!(!text.contains("images/card/2.jpg.z"));
+    assert!(!text.contains("images/card/missing.jpg"));
+    assert_eq!(
+        get(&url, "/manifest.crc").1,
+        format!("{},{}\r\n", crc32(&served), served.len()).into_bytes()
+    );
+    // The face is served raw from the player's own pack.
+    assert_eq!(
+        get(&url, &format!("/562/images/card/1.jpg?{}", crc32(card))),
+        (ok.clone(), card.to_vec())
+    );
+    // The second pack holds the announced CRC even though the first holds the name.
+    assert_eq!(
+        get(&url, &format!("/562/images/card/3.jpg?{}", crc32(card3))),
+        (ok.clone(), card3.to_vec())
+    );
+    let (status, body) = get(&url, &format!("/562/images/card/2.jpg.z?{}", crc32(card2)));
+    assert_eq!(status, ok);
+    assert_eq!(inflate(&body[8..]), card2);
+    // A base row without a lab file is filled from the pack; an existing base file
+    // wins, and the pack's other CRC does not shadow it.
+    assert_eq!(
+        get(&url, &format!("/562/filled.dds?{}", crc32(card2))),
+        (ok.clone(), card2.to_vec())
+    );
+    assert_eq!(get(&url, "/562/flat.dds?1"), (ok.clone(), base.to_vec()));
+    let announced = get(&url, "/manifest.crc").1;
+    let missing = ("HTTP/1.0 404 Not Found".to_owned(), Vec::new());
+    for target in [
+        format!("/562/images/card/3.jpg?{}", crc32(stale)),
+        format!("/562/images/card/missing.jpg?7"),
+        format!("/562/images/../card/1.jpg?{}", crc32(card)),
+        format!("/562/images/card/1.jpg?{}", crc32(card) + 1),
+    ] {
+        assert_eq!(get(&url, &target), missing, "{target}");
+    }
+    // Refusals changed nothing: the announced body and a valid face are unchanged.
+    assert_eq!(get(&url, "/manifest.crc").1, announced);
+    assert_eq!(
+        get(&url, &format!("/562/images/card/1.jpg?{}", crc32(card))),
+        (ok, card.to_vec())
+    );
+}
+
+#[test]
+fn a_pack_that_links_backwards_is_ignored() {
+    let scratch = Scratch::new();
+    let assets = scratch.0.join("assets");
+    fs::create_dir(&assets).unwrap();
+    let card = b"synthetic card".as_slice();
+    fs::write(scratch.0.join("Assets_manifest.txt"), b"flat.dds,1,2\r\n").unwrap();
+    let mut bytes = pack(&[("images/card/1.jpg", card)]);
+    // The first directory block points into its own header area; a backward or
+    // overlapping link must be refused instead of rescanned.
+    bytes[..4].copy_from_slice(&8_u32.to_be_bytes());
+    fs::write(assets.join("assetpack000W_000.pack"), bytes).unwrap();
+    fs::write(
+        assets.join("assetpack000_manifest.txt"),
+        row("images/card/1.jpg", card),
+    )
+    .unwrap();
+    let plan = LaunchPlan::build(
+        &scratch.0,
+        "127.0.0.1:20042",
+        None,
+        LaunchSettings::default(),
+        &mut LocalLoginStub,
+    )
+    .unwrap();
+    assert_eq!(
+        get(
+            &plan.assets.url,
+            &format!("/562/images/card/1.jpg?{}", crc32(card))
+        ),
+        ("HTTP/1.0 404 Not Found".to_owned(), Vec::new())
+    );
+}
