+/// The native envelope (`manifest.txt.z` and `.z` asset bodies).
+fn wire(raw: &[u8]) -> Vec<u8> {
+    let mut body = Vec::with_capacity(raw.len() / 2 + 16);
+    body.extend_from_slice(&MAGIC.to_be_bytes());
+    body.extend_from_slice(&(raw.len() as u32).to_be_bytes());
+    body.extend_from_slice(&miniz_oxide::deflate::compress_to_vec_zlib(raw, 6));
+    body
+}
