+/// One big-endian pack directory block with each entry's raw bytes after it.
+fn pack(entries: &[(&str, &[u8])]) -> Vec<u8> {
+    let directory = 8 + entries
+        .iter()
+        .map(|(name, _)| 4 + name.len() + 12)
+        .sum::<usize>();
+    let mut bytes = Vec::new();
+    bytes.extend_from_slice(&0_u32.to_be_bytes());
+    bytes.extend_from_slice(&(entries.len() as u32).to_be_bytes());
+    let mut payload = Vec::new();
+    for (name, raw) in entries {
+        bytes.extend_from_slice(&(name.len() as u32).to_be_bytes());
+        bytes.extend_from_slice(name.as_bytes());
+        bytes.extend_from_slice(&((directory + payload.len()) as u32).to_be_bytes());
+        bytes.extend_from_slice(&(raw.len() as u32).to_be_bytes());
+        bytes.extend_from_slice(&crc32(raw).to_be_bytes());
+        payload.extend_from_slice(raw);
+    }
+    bytes.extend_from_slice(&payload);
+    bytes
+}
+
+fn inflate(body: &[u8]) -> Vec<u8> {
+    miniz_oxide::inflate::decompress_to_vec_zlib(body).unwrap()
+}
+
+fn row(name: &str, raw: &[u8]) -> String {
+    format!("{name},{},{}\r\n", crc32(raw), raw.len())
+}
